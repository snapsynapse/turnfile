#!/bin/sh
set -eu

if [ -z "${TURNFILE_AGENT:-}" ]; then
  echo "ownership guard: TURNFILE_AGENT is required; refusing to infer an agent identity" >&2
  echo "Set TURNFILE_AGENT=codex or TURNFILE_AGENT=claude for the committing session." >&2
  exit 1
fi

agent="$TURNFILE_AGENT"

case "$agent" in
  codex)
    blocked='
skills/claude/
skills/claude-opus_4.6/
skills/gemini-3/
working-session/boot-claude.md
working-session/chat-claude.md
working-session/boot-gemini.md
working-session/chat-gemini.md
'
    ;;
  claude)
    blocked='
skills/codex/
skills/codex_5.3/
skills/gemini-3/
working-session/boot-codex.md
working-session/chat-codex.md
working-session/boot-gemini.md
working-session/chat-gemini.md
'
    ;;
  *)
    echo "ownership guard: unknown TURNFILE_AGENT '$agent'" >&2
    exit 1
    ;;
esac

changed_paths="$(
  {
    git diff --name-only
    git diff --cached --name-only
    git ls-files --others --exclude-standard
  } | sort -u
)"

violations=""
for path in $changed_paths; do
  for blocked_path in $blocked; do
    [ -n "$blocked_path" ] || continue
    case "$path" in
      "$blocked_path"|"$blocked_path"*)
        violations="${violations}${path}
"
        ;;
    esac
  done
done

if [ -n "$violations" ]; then
  echo "ownership guard: refusing commit for TURNFILE_AGENT=$agent" >&2
  echo "peer-owned files changed in this worktree:" >&2
  printf '%s' "$violations" | sed 's/^/  - /' >&2
  echo "Route requested edits to the owning agent instead of committing them from this lane." >&2
  exit 1
fi

exit 0
